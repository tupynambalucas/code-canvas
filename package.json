{
  "name": "@tupynambalucasdev/codecanvas",
  "version": "1.0.0",
  "packageManager": "pnpm@11.9.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0"
    }
  },
  "scripts": {
    "// Docs": "---------------------------------------------",
    "docs:typecheck": "pnpm --filter @codecanvas/docs typecheck",
    "docs:lint": "pnpm --filter @codecanvas/docs lint",
    "docs:generate:changelog": "pnpm --filter @codecanvas/docs docs:generate:changelog",
    "docs:generate:roadmap": "pnpm --filter @codecanvas/docs docs:generate:roadmap",
    "docs:dev": "pnpm --filter @codecanvas/docs start",
    "docs:dev:pt": "pnpm --filter @codecanvas/docs start:pt",
    "docs:build": "turbo run build --filter=@codecanvas/docs",
    "docs:preview": "pnpm docs:build && pnpm --filter @codecanvas/docs serve",
    "docs:clear": "pnpm --filter @codecanvas/docs clear",
    "docs:down": "pnpm dlx kill-port 3002",
    "// Studio / Penpot": "---------------------------------------------",
    "studio:lint": "turbo run lint --filter=@codecanvas-studio/*",
    "studio:typecheck": "turbo run typecheck --filter=@codecanvas-studio/*",
    "studio:bucket": "pnpm --filter @codecanvas-studio/assets bucket",
    "penpot:up": "pnpm --filter @codecanvas-studio/penpot penpot:up",
    "penpot:down": "pnpm --filter @codecanvas-studio/penpot penpot:down",
    "penpot:reset": "pnpm --filter @codecanvas-studio/penpot penpot:reset",
    "penpot:update": "pnpm --filter @codecanvas-studio/penpot penpot:update",
    "penpot:aide:up": "pnpm --filter @codecanvas-studio/penpot aide:up",
    "penpot:aide:down": "pnpm --filter @codecanvas-studio/penpot aide:down",
    "// Tools Context": "---------------------------------------------",
    "tools:lint": "turbo run lint --filter=@codecanvas-tools/*",
    "tools:typecheck": "turbo run typecheck --filter=@codecanvas-tools/*",
    "// Tools Turbo": "---------------------------------------------",
    "turborepo:devtools:up": "turbo devtools",
    "turborepo:devtools:down": "pnpm dlx kill-port 9876",
    "turborepo:up": "pnpm --filter @codecanvas-tools/turborepo cache:up",
    "turborepo:down": "pnpm --filter @codecanvas-tools/turborepo cache:down",
    "turborepo:reset": "pnpm --filter @codecanvas-tools/turborepo cache:reset",
    "turborepo:logs": "pnpm --filter @codecanvas-tools/turborepo cache:logs",
    "// Tools Mcp": "---------------------------------------------",
    "mcp:up": "pnpm --filter @codecanvas-tools/mcp mcp:up",
    "mcp:down": "pnpm --filter @codecanvas-tools/mcp mcp:down",
    "mcp:reset": "pnpm --filter @codecanvas-tools/mcp mcp:reset",
    "// Tools Agents": "---------------------------------------------",
    "agents:up": "pnpm --filter @codecanvas-tools/agents agents:up",
    "agents:down": "pnpm --filter @codecanvas-tools/agents agents:down",
    "agents:reset": "pnpm --filter @codecanvas-tools/agents agents:reset",
    "antigravity:up": "pnpm --filter @codecanvas-tools/agents antigravity:up",
    "antigravity:down": "pnpm --filter @codecanvas-tools/agents antigravity:down",
    "antigravity:reset": "pnpm --filter @codecanvas-tools/agents antigravity:reset",
    "copilot:up": "pnpm --filter @codecanvas-tools/agents copilot:up",
    "copilot:down": "pnpm --filter @codecanvas-tools/agents copilot:down",
    "copilot:reset": "pnpm --filter @codecanvas-tools/agents copilot:reset",
    "antigravity:auth": "pnpm --filter @codecanvas-tools/agents antigravity:auth",
    "copilot:auth": "pnpm --filter @codecanvas-tools/agents copilot:auth",
    "github:services:up": "pnpm --filter @codecanvas-tools/github github:services:up",
    "github:services:down": "pnpm --filter @codecanvas-tools/github github:services:down",
    "github:services:reset": "pnpm --filter @codecanvas-tools/github github:services:reset",
    "// Extension": "---------------------------------------------",
    "extension:lint": "pnpm --filter @codecanvas/extension lint",
    "extension:typecheck": "pnpm --filter @codecanvas/extension typecheck",
    "extension:build": "pnpm --filter @codecanvas/extension build",
    "extension:dev": "pnpm --filter @codecanvas/extension dev",
    "extension:test": "pnpm --filter @codecanvas/extension test",
    "// CI/CD & Quality": "-------------------------------------------------",
    "format:check": "prettier --check --ignore-path shared/config/.prettierignore .",
    "format:write": "prettier --write --ignore-path shared/config/.prettierignore .",
    "version:changeset": "changeset",
    "version:bump": "changeset version",
    "version:publish": "changeset publish",
    "project:clear": "pnpm dlx npkill",
    "husky:test": "tsx tools/scripts/test-hooks.ts",
    "git:ignore-compiled-docs": "git update-index --skip-worktree CHANGELOG.md ROADMAP.md",
    "git:track-compiled-docs": "git update-index --no-skip-worktree CHANGELOG.md ROADMAP.md",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-path shared/config/.prettierignore"
    ],
    "*.mdx": [
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write --ignore-path shared/config/.prettierignore"
    ]
  },
  "dependencies": {
    "fast-glob": "catalog:"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "catalog:",
    "fast-glob": "catalog:",
    "@changesets/cli": "catalog:",
    "@clack/prompts": "catalog:",
    "@eslint/compat": "catalog:tooling-stack",
    "@eslint/js": "catalog:tooling-stack",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:tooling-stack",
    "eslint": "catalog:tooling-stack",
    "eslint-config-prettier": "catalog:tooling-stack",
    "eslint-import-resolver-typescript": "catalog:tooling-stack",
    "eslint-plugin-import": "catalog:tooling-stack",
    "eslint-plugin-mdx": "catalog:tooling-stack",
    "eslint-plugin-prettier": "catalog:tooling-stack",
    "eslint-plugin-react": "catalog:web-stack",
    "eslint-plugin-react-hooks": "catalog:web-stack",
    "eslint-plugin-react-refresh": "catalog:web-stack",
    "husky": "catalog:",
    "kill-port": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:tooling-stack",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:tooling-stack",
    "wrangler": "catalog:",
    "@codecanvas-shared/config": "workspace:*"
  }
}
