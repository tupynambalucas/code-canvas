{
  "name": "@codecanvas-tools/github",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Tupynambá Lucas Varela Rodrigues <tupynambalucas.dev>",
  "description": "Elo Orgânico Tools Package",
  "license": "https://github.com/tupynambalucas/codecanvas/tree/main#license",
  "homepage": "https://github.com/tupynambalucas/codecanvas/tree/main/tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupynambalucas/codecanvas.git",
    "directory": "tools"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "github:services:up": "docker compose -f infrastructure/docker/compose.yaml up -d gh git",
    "github:services:down": "docker compose -f infrastructure/docker/compose.yaml down",
    "github:services:reset": "docker compose -f infrastructure/docker/compose.yaml down --volumes && docker compose -f infrastructure/docker/compose.yaml up -d --build gh git"
  },
  "dependencies": {
    "@codecanvas/docs": "workspace:*"
  },
  "devDependencies": {
    "@codecanvas-shared/config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
